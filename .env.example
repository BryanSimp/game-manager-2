# ---- Database ----
DATABASE_URL=postgres://gm:gm_dev_password@localhost:5432/gamemanager
POSTGRES_USER=gm
POSTGRES_PASSWORD=gm_dev_password
POSTGRES_DB=gamemanager

# ---- Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-generate-a-real-secret
# Public URL of the API (prod: https://gm.yourdomain.com)
BETTER_AUTH_URL=http://localhost:3001
# Close registration after your household has signed up
ALLOW_REGISTRATION=true

# ---- API server ----
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated extra CORS origins (Expo dev needs your LAN IP; web dev server included by default)
CORS_ORIGINS=http://localhost:5173

# ---- IGDB (Twitch developer app; can also be set later in admin settings) ----
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- OCR (Phase 3) ----
OCR_PROVIDER=tesseract

# ---- Images ----
IMAGE_DIR=/data/images

# ---- Misc ----
TZ=America/Chicago

# ---- Mobile (apps/mobile/.env) ----
# Expo Go on your phone must reach the API over LAN, e.g. http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
