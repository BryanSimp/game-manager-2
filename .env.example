# ---- Database ----
DATABASE_URL=postgres://gm:gm_dev_password@localhost:5432/gamemanager
POSTGRES_USER=gm
POSTGRES_PASSWORD=gm_dev_password
POSTGRES_DB=gamemanager

# ---- Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-generate-a-real-secret
# Public URL of the API (prod: https://gm.yourdomain.com)
BETTER_AUTH_URL=http://localhost:3001
# Close registration after your household has signed up
ALLOW_REGISTRATION=true

# ---- API server ----
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated extra CORS origins (Expo dev needs your LAN IP; web dev server included by default)
CORS_ORIGINS=http://localhost:5173

# ---- Self-hosting (deploy/docker-compose.selfhost.yml) ----
# The URL people actually type into a browser, port included. Sign-in and
# password-reset links are built from it, so it must match exactly — including
# https:// once something terminates TLS in front.
APP_URL=http://localhost:8080
# Host port nginx binds to
WEB_PORT=8080

# ---- IGDB (Twitch developer app; can also be set later in admin settings) ----
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- Steam (steamcommunity.com/dev/apikey) — library import + achievements ----
STEAM_API_KEY=

# ---- SteamGridDB — alternate cover art browsing. No key, no browser. ----
STEAMGRIDDB_API_KEY=

# ---- Password-reset email (Resend). Without a key the reset flow is dead. ----
# resend.dev's default sender only delivers to the Resend account owner, so
# other people's resets need a verified domain in EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=

# ---- OCR import pipeline ----
# tesseract (free, local — fine for library screenshots) | anthropic (Claude
# vision — needed for photos of physical shelves; shelf photos auto-upgrade
# to anthropic whenever ANTHROPIC_API_KEY is set)
OCR_PROVIDER=tesseract
ANTHROPIC_API_KEY=
# Vision model for shelf photos (default claude-opus-4-8; claude-haiku-4-5 is cheaper)
OCR_ANTHROPIC_MODEL=

# ---- Images ----
IMAGE_DIR=/data/images

# ---- Misc ----
TZ=America/Chicago

# ---- Mobile (apps/mobile/.env) ----
# Expo Go on your phone must reach the API over LAN, e.g. http://192.168.1.50:3001
EXPO_PUBLIC_API_URL=http://192.168.68.67:8081
